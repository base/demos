/**
 * Tool objects registered as read-only by a generated integration whose server has no access to
 * the wallet (e.g. the Nansen analytics MCP server). Tracked by object identity, not by name.
 */
const readOnlyToolObjects = new WeakSet<object>();

export function markReadOnlyTools(tools: any[], source: string): void {
  for (const tool of tools) {
    if (tool && typeof tool === "object") readOnlyToolObjects.add(tool);
  }
  console.log(`[guardrail] Classified ${tools.length} ${source} tool(s) as read-only.`);
}

const logOnly: ToolGuard = () => allow(undefined, "fixed protocol target");

const TOOL_GUARDS: Record<string, ToolGuard> = {
  // --- CDP server wallet -----------------------------------------------------
  cdp_send_transaction: (args) => checkRawCall(args.to, args.data, args.valueWei, "Destination"),
  cdp_contract_write: (args) => checkRawCall(args.contract, args.data, args.valueWei, "Contract"),
  cdp_erc20_approve: (args) => {
    const amount = parseBigInt(args.amountBaseUnits);
    if (amount === null) return block("amountBaseUnits must be an integer string.");
    const reason = checkApprovalAmount(args.token, args.spender, amount);
    return reason ? block(reason) : allow();
  },
  cdp_transfer: async (args, options) => {
    const destinationBlock = requireDestination("Destination", args.to);
    if (destinationBlock) return destinationBlock;
    const sizeBlock = await checkBaseUnitTokenAmount(args.token, args.amountBaseUnits, "Transfer amount", options);
    return sizeBlock ?? allow();
  },
  cdp_swap: async (args, options) => {
    const sizeBlock = await checkBaseUnitTokenAmount(args.fromToken, args.fromAmountBaseUnits, "Swap input", options);
    if (sizeBlock) return sizeBlock;
    return allow(clampSlippageBps(args, "slippageBps"));
  },

  // --- Uniswap / Aerodrome (fixed routers) -----------------------------------
  uniswap_swap: async (args, options) => {
    const sizeBlock = await checkHumanTokenAmount(args.tokenIn, args.amountIn, "Swap input", options);
    if (sizeBlock) return sizeBlock;
    return allow(clampSlippagePct(args, "slippagePct"));
  },
  uniswap_check_approval: async (args, options) => {
    if (!args.executeIfNeeded) return allow(undefined, "check only");
    // The final encoded approval is re-checked inside the tool (checkApprovalAmount).
    const sizeBlock = await checkHumanTokenAmount(args.token, args.amountIn, "Approval amount", options);
    return sizeBlock ?? allow();
  },
  aerodrome_swap: async (args, options) => {
    const sizeBlock = await checkHumanTokenAmount(args.tokenIn, args.amountIn, "Swap input", options);
    if (sizeBlock) return sizeBlock;
    return allow(clampSlippagePct(args, "slippagePct"));
  },
  aerodrome_check_approval: async (args, options) => {
    if (!args.executeIfNeeded) return allow(undefined, "check only");
    // The final encoded approval is re-checked by wallet.approveErc20 (assertApprovalAllowed).
    const sizeBlock = await checkHumanTokenAmount(args.token, args.amountIn, "Approval amount", options);
    return sizeBlock ?? allow();
  },

  // --- Avantis (fixed Trading/TradingStorage contracts) -----------------------
  avantis_approve_usdc: (args) => {
    const amount = toBaseUnits(args.amountUsdc, 6);
    if (amount === null) return block("amountUsdc must be a decimal number.");
    const reason = checkApprovalAmount("USDC", "0x8a311d7048c35985aa31c131b9a13e03a5f7422d", amount);
    return reason ? block(reason) : allow();
  },
  avantis_open_trade: async (args, options) => {
    const sizeBlock = await checkUsdSize(parseUsdAmount(args.collateralUsdc, 6), "Collateral", options);
    if (sizeBlock) return sizeBlock;
    return allow(clampSlippagePct(args, "slippagePct"));
  },
  avantis_update_margin: async (args, options) => {
    if (args.direction === "deposit") {
      const sizeBlock = await checkUsdSize(
        parseUsdAmount(args.collateralChangeUsdc, 6),
        "Margin deposit",
        options
      );
      if (sizeBlock) return sizeBlock;
    }
    return allow();
  },
  avantis_close_trade: logOnly,
  avantis_update_tp_sl: logOnly,
  avantis_cancel_limit_order: logOnly,

  // --- Virtuals ACP (pays arbitrary helper agents) ----------------------------
  virtuals_create_job: (args) => requireDestination("Helper agent wallet", args.wallet) ?? allow(),

  // --- Bankr (natural-language execution; blocked unless BANKR_ALLOW_EXECUTE=true) ---
  bankr_execute: async (args, options) => {
    if (!allowBankrExecute()) {
      return block(
        "bankr_execute takes free-text prompts that guardrails cannot reliably inspect, so it is disabled. " +
          "The operator can set BANKR_ALLOW_EXECUTE=true to enable it (unrestricted; only best-effort checks apply)."
      );
    }
    const prompt = String(args.prompt ?? "");
    const destinations = collectDestinations(prompt);
    if (hasOutboundIntent(prompt) || destinations.length > 0) {
      if (hasOutboundIntent(prompt) && destinations.length === 0) {
        return block(
          "Outbound transfers/approvals via Bankr must name an explicit allowlisted address."
        );
      }
      const notAllowed = destinations.filter((dest) => !isAllowedDestination(dest));
      if (notAllowed.length > 0) {
        return block(`Destination(s) ${notAllowed.join(", ")} not in ALLOWED_ADDRESSES.`);
      }
    }
    for (const usd of extractUsdAmounts(prompt)) {
      const sizeBlock = await checkUsdSize(usd, "Bankr trade amount", options);
      if (sizeBlock) return sizeBlock;
    }
    return allow(undefined, "BANKR_ALLOW_EXECUTE=true (best-effort checks only)");
  },

  // --- Sponge -----------------------------------------------------------------
  sponge_transfer_evm: async (args, options) => {
    const destinationBlock = requireDestination("Recipient", args.toAddress);
    if (destinationBlock) return destinationBlock;
    const sizeBlock = await checkHumanTokenAmount(args.token, args.amount, "Transfer amount", options);
    return sizeBlock ?? allow();
  },
  sponge_swap_base: async (args, options) => {
    const sizeBlock = await checkHumanTokenAmount(args.tokenIn, args.amountIn, "Swap input", options);
    if (sizeBlock) return sizeBlock;
    return allow(clampSlippagePct(args, "slippagePct"));
  },
  sponge_polymarket: async (args, options) => {
    const action = String(args.action ?? "");
    if (/^(get|list|search|view|fetch)/i.test(action) || args.amount == null) return allow();
    const sizeBlock = await checkUsdSize(parseUsdAmount(args.amount), "Polymarket amount", options);
    return sizeBlock ?? allow();
  },
  sponge_hyperliquid: async (args, options) => {
    const action = String(args.action ?? "");
    if (!/^open/i.test(action)) return allow();
    const sizeBlock = await checkUsdSize(parseUsdAmount(args.size), "Hyperliquid position size", options);
    return sizeBlock ?? allow();
  },
  sponge_x402_fetch: (args) => {
    let host = "";
    try {
      host = new URL(String(args.url)).hostname.toLowerCase();
    } catch {
      return block("Invalid URL.");
    }
    if (!getAllowedX402Hosts().has(host)) {
      return block(`Paid x402 host ${host} is not in ALLOWED_X402_HOSTS.`);
    }
    return allow();
  },
  sponge_submit_plan: (args, options) => checkSpongePlan(args, options),
  sponge_approve_plan: (args) => {
    const planId = String(args.planId ?? "").trim();
    if (!planId || !submittedPlanIds.has(planId)) {
      return block(
        `Plan ${planId || "(missing)"} was not submitted and checked by this agent via sponge_submit_plan.`
      );
    }
    submittedPlanIds.delete(planId);
    return allow(undefined, "plan was checked at submit");
  },
};

type Classification =
  | { kind: "read-only"; reason: string }
  | { kind: "guarded"; guard: ToolGuard }
  | { kind: "override" }
  | { kind: "blocked" };

export function classifyTool(tool: any): Classification {
  const name = String(tool?.name ?? "");
  if (hasOwn(TOOL_GUARDS, name)) return { kind: "guarded", guard: TOOL_GUARDS[name] };
  if (READ_ONLY_TOOLS.has(name)) return { kind: "read-only", reason: "read-only" };
  if (X402_PAID_DATA_TOOLS.has(name)) return { kind: "read-only", reason: "x402 data (payment capped)" };
  if (tool && typeof tool === "object" && readOnlyToolObjects.has(tool)) {
    return { kind: "read-only", reason: "read-only integration" };
  }
  if (getAllowedToolOverrides().has(name.toLowerCase())) return { kind: "override" };
  return { kind: "blocked" };
}

function blockedOutput(tool: any, toolName: string, reason: string): unknown {
  const message = errorResult(`[guardrail] Blocked ${toolName}: ${reason}`, { guardrail: true });
  return tool?.responseFormat === "content_and_artifact" ? [message, undefined] : message;
}

const unclassifiedGuard: ToolGuard = () =>
  block(
    "this tool has no guardrail policy and is not classified as read-only (default-deny). " +
      "The operator can allow it via GUARDRAIL_ALLOW_TOOLS."
  );

export function wrapWithGuardrails(tools: any[], options: GuardrailOptions = {}): any[] {
  const wrapped: any[] = [];
  for (const tool of tools) {
    const toolName = String(tool?.name ?? "");
    const classification = classifyTool(tool);
    if (classification.kind === "read-only") {
      wrapped.push(tool); // read-only: unchanged
      continue;
    }
    if (classification.kind === "override") {
      console.warn(`[guardrail] ${toolName} runs without guardrail checks (GUARDRAIL_ALLOW_TOOLS).`);
      wrapped.push(tool);
      continue;
    }
    const guard = classification.kind === "guarded" ? classification.guard : unclassifiedGuard;
    if (typeof tool?._call !== "function") {
      console.warn(`[guardrail] Dropping ${toolName}: cannot attach guardrail to this tool type.`);
      continue;
    }

    if (tool.__guardrailWrapped) {
      wrapped.push(tool); // already guarded; never apply the check twice
      continue;
    }

    // Guard the underlying execution. DynamicTool/DynamicStructuredTool (all generated and MCP
    // tools) execute via `func`, so `func` itself is replaced with the guarded version and `_call`
    // delegates to it: `.invoke`, `._call` and a direct `.func(...)` all run the check exactly once.
    // Tools without `func` are guarded at `_call`.
    const hasFunc = typeof tool.func === "function";
    const execute: (input: unknown, ...rest: unknown[]) => Promise<unknown> = hasFunc
      ? tool.func.bind(tool)
      : tool._call.bind(tool);
    const guarded = async (input: unknown, ...rest: unknown[]) => {
      const args: Args = input && typeof input === "object" ? (input as Args) : {};
      let decision: Decision;
      try {
        decision = await guard(args, options);
      } catch (error) {
        decision = block(`guardrail check failed: ${(error as Error)?.message ?? String(error)}`);
      }
      if (!decision.allow) {
        console.warn(`[guardrail] Blocked ${toolName}: ${decision.reason}`);
        return blockedOutput(tool, toolName, decision.reason);
      }
      console.log(`[guardrail] Allowed ${toolName}${decision.note ? ` (${decision.note})` : ""}`);
      const output = await execute(decision.args ?? input, ...rest);
      decision.afterCall?.(output);
      return output;
    };
    if (hasFunc) {
      tool.func = guarded;
      tool._call = (input: unknown, ...rest: unknown[]) => tool.func(input, ...rest);
    } else {
      tool._call = guarded;
    }
    tool.__guardrailWrapped = true;
    wrapped.push(tool);
  }
  return wrapped;
}

