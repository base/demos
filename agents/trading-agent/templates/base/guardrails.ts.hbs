/** Approvals at or above 2^255 (incl. maxUint256) are treated as unlimited and rejected. */
export const UNLIMITED_APPROVAL_THRESHOLD = 2n ** 255n;

const ADDRESS_SCAN_RE = /0x[0-9a-fA-F]{40}/g;
const ENS_SCAN_RE = /\b[a-z0-9-]+(?:\.[a-z0-9-]+)*\.(?:eth|base\.eth)\b/gi;

export function isAllowedDestination(destination: unknown): boolean {
  if (typeof destination !== "string" || !destination.trim()) return false;
  return getAllowedAddresses().has(destination.trim().toLowerCase());
}

function hasOwn(record: object, key: string): boolean {
  return Object.prototype.hasOwnProperty.call(record, key);
}

export function isAllowedSpender(spender: unknown): boolean {
  if (typeof spender !== "string") return false;
  const normalized = spender.trim().toLowerCase();
  return hasOwn(KNOWN_PROTOCOL_SPENDERS, normalized) || getAllowedAddresses().has(normalized);
}

export function isUnlimitedApproval(amount: bigint): boolean {
  return amount >= UNLIMITED_APPROVAL_THRESHOLD;
}

/** Known stablecoin metadata for `token`, else null (non-stablecoins have no USD cap). */
function knownStable(token: unknown): KnownToken | null {
  const known = resolveKnownToken(token);
  return known?.stable ? known : null;
}

/**
 * Policy for the final ERC-20 approval amount, shared by every approval path
 * (cdp_erc20_approve, wallet.approveErc20 used by protocol tools, Uniswap API approvals,
 * and decoded approve calldata). Returns a reason when blocked, else null.
 */
export function checkApprovalAmount(token: unknown, spender: unknown, amount: bigint): string | null {
  if (amount < 0n) return "Negative approval amount.";
  if (isUnlimitedApproval(amount)) {
    return `Unlimited approval (>= 2^255 / maxUint256) to ${spender} is blocked. Approve the exact amount needed.`;
  }
  if (!isAllowedSpender(spender)) {
    return `Spender ${spender} is not a known protocol router and not in ALLOWED_ADDRESSES.`;
  }
  const stable = knownStable(token);
  const cap = getMaxTradeUsd();
  if (stable && cap !== null && exceedsUsdCap(amount, stable.decimals, cap)) {
    return `Approval of $${baseUnitsToNumber(amount, stable.decimals)} exceeds MAX_TRADE_USD $${cap}.`;
  }
  return null;
}

/** Throwing variant of checkApprovalAmount for code paths that encode approvals directly. */
export function assertApprovalAllowed(token: unknown, spender: unknown, amount: bigint): void {
  const reason = checkApprovalAmount(token, spender, amount);
  if (reason) {
    console.warn(`[guardrail] Blocked approval: ${reason}`);
    throw new Error(`[guardrail] Blocked approval: ${reason}`);
  }
}

// ---------------------------------------------------------------------------
// Calldata decoding for raw transaction / contract write tools
// ---------------------------------------------------------------------------

type DecodedCall =
  | { kind: "erc20-transfer"; method: string; recipient: string; amount: bigint }
  | { kind: "approve"; method: string; spender: string; amount: bigint }
  | { kind: "approval-for-all"; method: string; operator: string; approved: boolean }
  | { kind: "nft-transfer"; method: string; recipient: string };

type CallSpec = {
  method: string;
  /** Minimum number of 32-byte words after the selector. */
  words: number;
  /**
   * Index of a dynamic `bytes` argument (head word holding its offset). Its offset/length are
   * validated against the calldata before decode runs.
   */
  bytesArg?: number;
  decode: (words: string[]) => DecodedCall | string;
};

function wordToAddress(word: string): string | null {
  if (!/^0{24}[0-9a-f]{40}$/.test(word)) return null;
  return `0x${word.slice(24)}`;
}

function addressArg(words: string[], index: number, label: string): string {
  const address = wordToAddress(words[index]);
  if (!address) throw new Error(`malformed ${label} argument`);
  return address;
}

