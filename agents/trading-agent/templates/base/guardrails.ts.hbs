/** Selectors rejected with a specific instruction for the model. */
const REJECTED_WITH_GUIDANCE: Record<string, string> = {
  "0x39509351":
    "increaseAllowance(address,uint256) is not allowed because guardrails cannot see the resulting total allowance. " +
    "Use approve(spender, amount) with the exact amount needed instead.",
};

/**
 * Validate an ABI-encoded dynamic `bytes` argument: the offset must be word-aligned and point just
 * past the head, the length must fit, the calldata must end exactly at the padded tail, and the
 * padding must be zero. Returns a reason when malformed, else null.
 */
function validateBytesArg(words: string[], headWords: number, argIndex: number): string | null {
  const offset = BigInt(`0x${words[argIndex]}`);
  const totalBytes = BigInt(words.length) * 32n;
  if (offset % 32n !== 0n) return "bytes offset is not word-aligned";
  if (offset < BigInt(headWords) * 32n || offset + 32n > totalBytes) return "bytes offset is out of bounds";
  const lengthIndex = Number(offset / 32n);
  const length = BigInt(`0x${words[lengthIndex]}`);
  const paddedLength = ((length + 31n) / 32n) * 32n;
  if (offset + 32n + paddedLength !== totalBytes) return "bytes length does not match calldata size";
  const tail = words.slice(lengthIndex + 1).join("");
  if (/[^0]/.test(tail.slice(Number(length) * 2))) return "bytes padding is not zero";
  return null;
}

/** Selectors that are always rejected (unless ALLOW_ARBITRARY_CALLDATA=true), with a clear reason. */
const EXPLICITLY_BLOCKED_SELECTORS: Record<string, string> = {
