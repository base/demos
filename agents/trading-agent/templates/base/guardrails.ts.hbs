/** Decode calldata into a recognized call, or return a reason it is not recognized. */
export function decodeRecognizedCall(data: string): DecodedCall | string {
  const hex = data.toLowerCase();
  if (!/^0x[0-9a-f]*$/.test(hex) || (hex.length - 2) % 2 !== 0) return "calldata is not valid hex";
  if (hex.length < 10) return "calldata is shorter than a 4-byte selector";
  const selector = hex.slice(0, 10);
  if (hasOwn(REJECTED_WITH_GUIDANCE, selector)) return `${REJECTED_WITH_GUIDANCE[selector]} (${selector})`;
  if (hasOwn(EXPLICITLY_BLOCKED_SELECTORS, selector)) {
    return `${EXPLICITLY_BLOCKED_SELECTORS[selector]} (${selector}) is not allowed`;
  }
  const spec = hasOwn(RECOGNIZED_CALLS, selector) ? RECOGNIZED_CALLS[selector] : undefined;
  if (!spec) return `unrecognized function selector ${selector}`;
  const body = hex.slice(10);
  if (body.length % 64 !== 0) return `${spec.method}: calldata is not word-aligned`;
  const words = body.match(/.{64}/g) ?? [];
  if (words.length < spec.words || (spec.bytesArg === undefined && words.length !== spec.words)) {
    return `${spec.method}: unexpected calldata length`;
  }
  if (spec.bytesArg !== undefined) {
    const bytesReason = validateBytesArg(words, spec.words, spec.bytesArg);
    if (bytesReason) return `${spec.method}: ${bytesReason}`;
  }
  try {
    return spec.decode(words);
  } catch (error) {
    return `${spec.method}: ${(error as Error).message}`;
  }
}

/** Decode approve/setApprovalForAll calldata (used by protocol tools). increaseAllowance returns null. */
export function inspectApprovalCalldata(
  data: unknown
): { method: string; spender: `0x${string}`; amount: bigint } | null {
  if (typeof data !== "string") return null;
  const decoded = decodeRecognizedCall(data);
  if (typeof decoded === "string") return null;
  if (decoded.kind === "approve") {
    return { method: decoded.method, spender: decoded.spender as `0x${string}`, amount: decoded.amount };
  }
  if (decoded.kind === "approval-for-all") {
    return {
      method: decoded.method,
      spender: decoded.operator as `0x${string}`,
      amount: decoded.approved ? 2n ** 256n - 1n : 0n,
    };
  }
  return null;
}

/**
 * Policy for raw calls (cdp_send_transaction, cdp_contract_write). The target must be in
 * ALLOWED_ADDRESSES, and the calldata must decode to a recognized token call whose effect
 * (recipient / spender / operator / amount) passes the same policies as the dedicated tools.
 */
export function checkRawCall(target: unknown, data: unknown, valueWei: unknown, label = "Destination"): Decision {
  const destinationBlock = requireDestination(label, target);
  if (destinationBlock) return destinationBlock;

  const value = valueWei == null || valueWei === "" ? 0n : parseBigInt(valueWei);
  if (value === null || value < 0n) return block("valueWei must be a non-negative integer string.");

  const hex = typeof data === "string" ? data.trim() : data == null ? "" : null;
  if (hex === null) return block("data must be a hex string.");
  if (hex === "" || hex === "0x") {
    // Plain ETH send to an allowlisted destination.
    return allow(undefined, value > 0n ? "ETH transfer to allowlisted destination" : "empty call");
  }

  const decoded = decodeRecognizedCall(hex);
  if (typeof decoded === "string") {
    // increaseAllowance etc. are rejected even with ALLOW_ARBITRARY_CALLDATA=true.
    if (hasOwn(REJECTED_WITH_GUIDANCE, hex.slice(0, 10).toLowerCase())) return block(decoded);
    if (allowArbitraryCalldata()) {
      return allow(undefined, `ALLOW_ARBITRARY_CALLDATA=true (${decoded})`);
    }
    return block(
      `${decoded}. Raw calls may only carry ERC-20/721/1155 transfer and approval calldata. ` +
        "The operator can set ALLOW_ARBITRARY_CALLDATA=true to grant unrestricted execution on allowlisted targets."
    );
  }
  if (value > 0n) return block(`${decoded.method} must not send ETH value.`);

  switch (decoded.kind) {
    case "erc20-transfer": {
      if (!isAllowedDestination(decoded.recipient)) {
        return block(`${decoded.method} recipient ${decoded.recipient} is not in ALLOWED_ADDRESSES.`);
      }
      const stable = knownStable(target);
      const cap = getMaxTradeUsd();
      if (stable && cap !== null && exceedsUsdCap(decoded.amount, stable.decimals, cap)) {
        return block(
          `${decoded.method} of $${baseUnitsToNumber(decoded.amount, stable.decimals)} exceeds MAX_TRADE_USD $${cap}.`
        );
      }
      return allow(undefined, `${decoded.method} to allowlisted recipient`);
    }
    case "approve": {
      const reason = checkApprovalAmount(target, decoded.spender, decoded.amount);
      return reason ? block(`${decoded.method}: ${reason}`) : allow(undefined, `${decoded.method} bounded`);
    }
    case "approval-for-all": {
      if (decoded.approved && !isAllowedDestination(decoded.operator)) {
        return block(`setApprovalForAll operator ${decoded.operator} is not in ALLOWED_ADDRESSES.`);
      }
      return allow(undefined, decoded.approved ? "setApprovalForAll to allowlisted operator" : "revoke setApprovalForAll");
    }
    case "nft-transfer": {
      if (!isAllowedDestination(decoded.recipient)) {
        return block(`${decoded.method} recipient ${decoded.recipient} is not in ALLOWED_ADDRESSES.`);
      }
      return allow(undefined, `${decoded.method} to allowlisted recipient`);
    }
  }
}

// ---------------------------------------------------------------------------
// Guard primitives
// ---------------------------------------------------------------------------

type Args = Record<string, any>;
type Decision =
  | { allow: true; args?: Args; note?: string; afterCall?: (output: unknown) => void }
  | { allow: false; reason: string };

export interface GuardrailOptions {
  /** Optional total wallet value in USD; enables MAX_POSITION_PCT checks when available. */
  getWalletValueUsd?: () => Promise<number | undefined> | number | undefined;
}

type ToolGuard = (args: Args, options: GuardrailOptions) => Decision | Promise<Decision>;

const allow = (args?: Args, note?: string): Decision => ({ allow: true, args, note });
const block = (reason: string): Decision => ({ allow: false, reason });

/** An exact USD-denominated amount: `units` at `decimals` (1 USD = 10^decimals units). */
type UsdAmount = { units: bigint; decimals: number };

/** Parse a human USD amount ("$50", "50.5", 50) exactly. 18 decimals unless the asset has fewer. */
function parseUsdAmount(value: unknown, decimals = 18): UsdAmount | null {
  const text = typeof value === "string" ? value.trim().replace(/^\$/, "") : value;
  const units = toBaseUnits(text, decimals);
  return units === null ? null : { units, decimals };
}

function requireDestination(label: string, destination: unknown): Decision | null {
  if (typeof destination !== "string" || !destination.trim()) {
    return block(`${label} is missing.`);
  }
  if (!isAllowedDestination(destination)) {
    return block(
      `${label} ${destination} is not in ALLOWED_ADDRESSES. Arbitrary destinations are blocked; the operator must allowlist it.`
    );
  }
  return null;
}

async function checkUsdSize(
  amount: UsdAmount | null,
  label: string,
  options: GuardrailOptions
): Promise<Decision | null> {
  if (amount === null) return block(`Could not parse ${label} as a number; refusing to execute.`);
  // Exact bigint comparisons; `usd` is only for messages.
  const usd = baseUnitsToNumber(amount.units, amount.decimals);
  const cap = getMaxTradeUsd();
  if (cap !== null && exceedsUsdCap(amount.units, amount.decimals, cap)) {
    return block(`${label} $${usd} exceeds MAX_TRADE_USD $${cap}.`);
  }
  if (options.getWalletValueUsd) {
    let walletValue: number | undefined;
    try {
      walletValue = await options.getWalletValueUsd();
    } catch {
      walletValue = undefined;
    }
    if (typeof walletValue === "number" && Number.isFinite(walletValue) && walletValue > 0) {
      if (exceedsUsdCap(amount.units, amount.decimals, (walletValue * MAX_POSITION_PCT) / 100)) {
        return block(
          `${label} $${usd} is ${((usd / walletValue) * 100).toFixed(2)}% of wallet value $${walletValue.toFixed(2)}, above MAX_POSITION_PCT ${MAX_POSITION_PCT}%.`
        );
      }
    }
  }
  return null;
}

/**
 * Size check for a human-readable token amount. Known stablecoins (by symbol OR address) are
 * converted with their real decimals, exactly like the protocol tools do, and capped in USD.
 * Non-stablecoin inputs have no USD cap (the scaffold does not price tokens).
 */
async function checkHumanTokenAmount(
  token: unknown,
  amount: unknown,
  label: string,
  options: GuardrailOptions
): Promise<Decision | null> {
  const known = resolveKnownToken(token);
  if (!known) return null;
  const baseUnits = toBaseUnits(amount, known.decimals);
  if (baseUnits === null) return block(`Could not parse ${label} "${amount}" as a decimal amount.`);
  if (isUnlimitedApproval(baseUnits)) return block(`${label} is unbounded.`);
  if (!known.stable) return null;
  return checkUsdSize({ units: baseUnits, decimals: known.decimals }, label, options);
}

/** Size check for an amount already expressed in token base units. */
async function checkBaseUnitTokenAmount(
  token: unknown,
  amountBaseUnits: unknown,
  label: string,
  options: GuardrailOptions
): Promise<Decision | null> {
  const raw = parseBigInt(amountBaseUnits);
  if (raw === null) return block(`${label} must be an integer base-unit string.`);
  const stable = knownStable(token);
  if (!stable) return null;
  return checkUsdSize({ units: raw, decimals: stable.decimals }, label, options);
}

/** Clamp a slippage input (percent) to SLIPPAGE_PCT; fills in the limit when omitted. */
function clampSlippagePct(args: Args, key: string): Args {
  const provided = typeof args[key] === "number" ? args[key] : null;
  if (provided === null || provided > SLIPPAGE_PCT || provided < 0) {
    if (provided !== null) {
      console.warn(`[guardrail] Clamping ${key} ${provided}% to SLIPPAGE_PCT ${SLIPPAGE_PCT}%.`);
    }
    return { ...args, [key]: SLIPPAGE_PCT };
  }
  return args;
}

function clampSlippageBps(args: Args, key: string): Args {
  const limitBps = Math.floor(SLIPPAGE_PCT * 100);
  const provided = typeof args[key] === "number" ? args[key] : null;
  if (provided === null || provided > limitBps || provided < 0) {
    if (provided !== null) {
      console.warn(`[guardrail] Clamping ${key} ${provided}bps to SLIPPAGE_PCT ${limitBps}bps.`);
    }
    return { ...args, [key]: limitBps };
  }
  return args;
}

function hasOutboundIntent(text: string): boolean {
  return /\b(send|sends|sending|transfer|transfers|withdraw|withdrawal|bridge|pay|tip|donate|approve|approval|allowance|drain|sweep|move|moves|moving)\b/i.test(text);
}

function collectDestinations(text: string): string[] {
  return [...(text.match(ADDRESS_SCAN_RE) ?? []), ...(text.match(ENS_SCAN_RE) ?? [])];
}

/** Best-effort USD amount extraction from natural language ("$50", "50 usdc"). */
function extractUsdAmounts(text: string): Array<UsdAmount | null> {
  const amounts: Array<UsdAmount | null> = [];
  const patterns = [
    /\$\s*([\d,]+(?:\.\d+)?)/g,
    /([\d,]+(?:\.\d+)?)\s*(?:usd|usdc|usdbc|dai|dollars?)\b/gi,
  ];
  for (const pattern of patterns) {
    for (const match of text.matchAll(pattern)) {
      amounts.push(parseUsdAmount(match[1]));
    }
  }
  return amounts;
}

// ---------------------------------------------------------------------------
// Sponge plans: steps are validated with the same policies as the equivalent direct tools,
// and only plan IDs submitted (and accepted) by this process can be approved.
// ---------------------------------------------------------------------------

const PLAN_STEP_POLICIES: Record<string, { tool: string; params: string[] }> = {
  swap: { tool: "sponge_swap_base", params: ["tokenIn", "tokenOut", "amountIn", "slippagePct"] },
  transfer: { tool: "sponge_transfer_evm", params: ["token", "toAddress", "amount"] },
};

const submittedPlanIds = new Set<string>();

function extractPlanId(output: unknown): string | null {
  const text = Array.isArray(output) ? output[0] : output;
  if (typeof text !== "string") return null;
  try {
    const parsed = JSON.parse(text);
    if (parsed?.success === false) return null;
    const plan = parsed?.plan ?? parsed;
    const id = plan?.planId ?? plan?.id ?? plan?.plan_id ?? plan?.plan?.id ?? plan?.data?.planId ?? plan?.data?.id;
    return typeof id === "string" || typeof id === "number" ? String(id) : null;
  } catch {
    return null;
  }
}

async function checkSpongePlan(args: Args, options: GuardrailOptions): Promise<Decision> {
  const steps: unknown[] = Array.isArray(args.steps) ? args.steps : [];
  if (steps.length === 0) return block("Plan has no steps.");
  const checkedSteps: Args[] = [];
  for (const [index, rawStep] of steps.entries()) {
    const label = `Plan step ${index + 1}`;
    const step = (rawStep ?? {}) as Args;
    const action = String(step.action ?? "").trim().toLowerCase();
    const policy = hasOwn(PLAN_STEP_POLICIES, action) ? PLAN_STEP_POLICIES[action] : undefined;
    if (!policy) {
      return block(
        `${label} action "${step.action}" is not supported. Allowed plan actions: ${Object.keys(PLAN_STEP_POLICIES).join(", ")}.`
      );
    }
    const params: Args = step.params && typeof step.params === "object" ? { ...step.params } : {};
    const unknownParams = Object.keys(params).filter(
      (key) => !policy.params.includes(key) && key !== "chain"
    );
    if (unknownParams.length > 0) {
      return block(`${label} (${action}) has unsupported params: ${unknownParams.join(", ")}.`);
    }
    if ("chain" in params && String(params.chain).toLowerCase() !== "base") {
      return block(`${label} (${action}) chain must be "base".`);
    }
    const { chain, ...toolArgs } = params;
    const decision = await TOOL_GUARDS[policy.tool](toolArgs, options);
    if (!decision.allow) return block(`${label} (${action}): ${decision.reason}`);
    const checkedParams = { ...(decision.args ?? toolArgs), ...(chain !== undefined ? { chain } : {}) };
    checkedSteps.push({ ...step, params: checkedParams });
  }
  return {
    allow: true,
    args: { ...args, steps: checkedSteps },
    note: `${checkedSteps.length} plan step(s) checked`,
    afterCall: (output) => {
      const planId = extractPlanId(output);
      if (planId) {
        submittedPlanIds.add(planId);
      } else {
        console.warn("[guardrail] sponge_submit_plan response had no recognizable plan ID; it cannot be approved.");
      }
    },
  };
}

