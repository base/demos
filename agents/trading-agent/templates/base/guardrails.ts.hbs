import { errorResult } from "./tool-result.js";

/*
 * Runtime guardrails.
 *
 * These checks are enforced in code around every tool the agent can call (default-deny).
 * They do not depend on the model following the strategy prompt. A blocked call returns a
 * JSON error string to the model (it never throws) and logs a `[guardrail] ...` line.
 *
 * The operator can loosen or tighten them with env vars (see .env.example) or by editing
 * this file. Tools classified as read-only pass through unchanged; every other tool must have
 * a policy below or be listed in GUARDRAIL_ALLOW_TOOLS, otherwise calls to it are blocked.
 */

const TEST_MODE = /^(1|true|yes)$/i.test(process.env.TEST_MODE ?? "{{testMode}}");
const DEFAULT_SLIPPAGE_PCT = TEST_MODE
  ? {{defaultSlippagePct}}
  : {{guardrails.slippagePct}};
const DEFAULT_STOP_LOSS_PCT = TEST_MODE
  ? {{defaultStopLossPct}}
  : {{guardrails.stopLossPct}};
const DEFAULT_MAX_POSITION_PCT = TEST_MODE
  ? {{defaultMaxPositionPct}}
  : {{guardrails.maxPositionPct}};
const DEFAULT_MAX_TRADE_USD = 100;

const SLIPPAGE_PCT = parseFloat(process.env.SLIPPAGE_PCT ?? String(DEFAULT_SLIPPAGE_PCT));
const STOP_LOSS_PCT = parseFloat(process.env.STOP_LOSS_PCT ?? String(DEFAULT_STOP_LOSS_PCT));
const MAX_POSITION_PCT = parseFloat(process.env.MAX_POSITION_PCT ?? String(DEFAULT_MAX_POSITION_PCT));

export function checkSlippage(expectedPrice: number, actualPrice: number): boolean {
  const slippage = Math.abs((actualPrice - expectedPrice) / expectedPrice) * 100;
  if (slippage > SLIPPAGE_PCT) {
    console.warn(
      `[guardrail] Slippage ${slippage.toFixed(2)}% exceeds limit ${SLIPPAGE_PCT}%. Blocking trade.`
    );
    return false;
  }
  return true;
}

export function checkStopLoss(entryPrice: number, currentPrice: number): boolean {
  const drawdown = ((entryPrice - currentPrice) / entryPrice) * 100;
  if (drawdown > STOP_LOSS_PCT) {
    console.warn(
      `[guardrail] Drawdown ${drawdown.toFixed(2)}% exceeds stop-loss ${STOP_LOSS_PCT}%. Triggering exit.`
    );
    return true; // true = stop-loss triggered
  }
  return false;
}

export function checkPositionSize(
  tradeValue: number,
  walletValue: number
): boolean {
  const positionPct = (tradeValue / walletValue) * 100;
  if (positionPct > MAX_POSITION_PCT) {
    console.warn(
      `[guardrail] Position ${positionPct.toFixed(2)}% exceeds max ${MAX_POSITION_PCT}%. Blocking trade.`
    );
    return false;
  }
  return true;
}

// ---------------------------------------------------------------------------
// Operator-configurable policy (read at call time so env changes apply on restart/tests)
// ---------------------------------------------------------------------------

function parseList(value: string | undefined): string[] {
  return (value ?? "")
    .split(",")
    .map((entry) => entry.trim().toLowerCase())
    .filter(Boolean);
}

function envFlag(name: string): boolean {
  return /^(1|true|yes)$/i.test(process.env[name]?.trim() ?? "");
}

/** Destinations (wallets, contracts, ENS names) the agent may send funds/calls/approvals to. */
export function getAllowedAddresses(): Set<string> {
  return new Set(parseList(process.env.ALLOWED_ADDRESSES));
}

/** Hostnames that pay-per-request proxies (sponge_x402_fetch) may pay. */
export function getAllowedX402Hosts(): Set<string> {
  return new Set(parseList(process.env.ALLOWED_X402_HOSTS));
}

/** Extra tool names the operator explicitly trusts. They run without any guardrail policy. */
export function getAllowedToolOverrides(): Set<string> {
  return new Set(parseList(process.env.GUARDRAIL_ALLOW_TOOLS));
}

/**
 * ALLOW_ARBITRARY_CALLDATA=true lets cdp_send_transaction / cdp_contract_write send calldata the
 * guardrails cannot decode to allowlisted targets. That grants the agent unrestricted execution
 * authority on every allowlisted contract. Default: false.
 */
export function allowArbitraryCalldata(): boolean {
  return envFlag("ALLOW_ARBITRARY_CALLDATA");
}

/**
 * BANKR_ALLOW_EXECUTE=true enables bankr_execute. Bankr takes free-text prompts that the
 * guardrails can only inspect on a best-effort basis, so enabling it is effectively unrestricted.
 * Default: false.
 */
export function allowBankrExecute(): boolean {
  return envFlag("BANKR_ALLOW_EXECUTE");
}

/** Absolute per-trade cap in USD for tool inputs that are USD/stablecoin-denominated. */
export function getMaxTradeUsd(): number | null {
  const raw = process.env.MAX_TRADE_USD?.trim();
  if (!raw) return DEFAULT_MAX_TRADE_USD;
  if (/^(unlimited|off|none)$/i.test(raw)) return null;
  const parsed = Number(raw);
  if (Number.isFinite(parsed) && parsed > 0) return parsed;
  console.warn(
    `[guardrail] Invalid MAX_TRADE_USD="${raw}". Falling back to ${DEFAULT_MAX_TRADE_USD}.`
  );
  return DEFAULT_MAX_TRADE_USD;
}

// ---------------------------------------------------------------------------
// Known tokens (shared by the protocol tools and the guard so both use the same decimals)
// ---------------------------------------------------------------------------

export interface KnownToken {
  symbol: string;
  address: `0x${string}`;
  decimals: number;
  /** USD-pegged stablecoin: amounts are capped by MAX_TRADE_USD. */
  stable: boolean;
}

export const KNOWN_TOKENS: KnownToken[] = [
  { symbol: "WETH", address: "0x4200000000000000000000000000000000000006", decimals: 18, stable: false },
  { symbol: "USDC", address: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", decimals: 6, stable: true },
  { symbol: "USDbC", address: "0xd9aAEc86B65D86f6A7B5B1b0c42FFA531710b6CA", decimals: 6, stable: true },
  { symbol: "DAI", address: "0x50c5725949A6F0c72E6C4a641F24049A917DB0Cb", decimals: 18, stable: true },
  { symbol: "cbBTC", address: "0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf", decimals: 8, stable: false },
];

export const KNOWN_TOKEN_SYMBOLS = KNOWN_TOKENS.map((token) => token.symbol);

/** Resolve a token symbol (case-insensitive) or address to a known token, else null. */
export function resolveKnownToken(input: unknown): KnownToken | null {
  if (typeof input !== "string") return null;
  const normalized = input.trim().toLowerCase();
  return (
    KNOWN_TOKENS.find(
      (token) => token.symbol.toLowerCase() === normalized || token.address.toLowerCase() === normalized
    ) ?? null
  );
}

/**
 * Convert a human-readable decimal amount to token base units. Fractional digits beyond the
 * token's decimals are rounded UP so the guard never underestimates what execution spends.
 * Returns null for anything that is not a plain non-negative decimal number.
 */
export function toBaseUnits(amount: unknown, decimals: number): bigint | null {
  const text = typeof amount === "number" ? numberToPlainDecimal(amount) : amount;
  if (typeof text !== "string") return null;
  const cleaned = text.trim().replace(/[,_\s]/g, "");
  const match = /^(\d*)(?:\.(\d*))?$/.exec(cleaned);
  if (!match || (match[1] === "" && !match[2])) return null;
  const whole = match[1] || "0";
  const fraction = match[2] ?? "";
  const kept = fraction.slice(0, decimals).padEnd(decimals, "0");
  const dropped = fraction.slice(decimals);
  let units = BigInt(whole) * 10n ** BigInt(decimals) + BigInt(kept || "0");
  if (/[1-9]/.test(dropped)) units += 1n;
  return units;
}

/** Base units -> approximate number. For logs/messages only; never compare caps with this. */
function baseUnitsToNumber(raw: bigint, decimals: number): number {
  const scale = 10n ** BigInt(decimals);
  return Number(raw / scale) + Number(raw % scale) / Number(scale);
}

/** Expand a finite non-negative number to a plain decimal string (no exponent). */
function numberToPlainDecimal(value: number): string | null {
  if (!Number.isFinite(value) || value < 0) return null;
  return value.toLocaleString("en-US", { useGrouping: false, maximumFractionDigits: 20 });
}

/**
 * Convert a USD cap/threshold to token base units, rounding DOWN so the bigint cap is never
 * looser than the configured number. Use this (not floats) for every cap comparison.
 */
export function usdToBaseUnitsFloor(usd: number, decimals: number): bigint {
  const text = numberToPlainDecimal(usd);
  if (text === null) return 0n;
  const [whole, fraction = ""] = text.split(".");
  const kept = fraction.slice(0, decimals).padEnd(decimals, "0");
  return BigInt(whole || "0") * 10n ** BigInt(decimals) + BigInt(kept || "0");
}

/** True when `amount` base units (with `decimals`) exceeds `capUsd`. Exact bigint comparison. */
function exceedsUsdCap(amount: bigint, decimals: number, capUsd: number): boolean {
  return amount > usdToBaseUnitsFloor(capUsd, decimals);
}

function parseBigInt(value: unknown): bigint | null {
  try {
    const text = String(value).trim();
    if (!/^(0x[0-9a-fA-F]+|\d+)$/.test(text)) return null;
    return BigInt(text);
  } catch {
    return null;
  }
}

