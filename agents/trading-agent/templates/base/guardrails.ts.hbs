  "0x5ae401dc": "multicall(uint256,bytes[])",
  "0x1f0464d1": "multicall(bytes32,bytes[])",
  "0x252dba42": "Multicall aggregate",
  "0x82ad56cb": "Multicall3 aggregate3",
