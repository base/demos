{{#if (eq wallet "cdp-server-wallet")}}
# CDP Server Wallet
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Optional: set to reuse an existing CDP account (defaults to "{{name}}-primary" which creates a new wallet)
# CDP_EVM_ACCOUNT_NAME=my-existing-account
{{/if}}
{{#if isBankr}}
# Bankr Agent API
BANKR_API_KEY=bk_...
{{/if}}
{{#if isSponge}}
# Sponge Wallet
SPONGE_API_KEY=
{{/if}}

# Base Mainnet
RPC_URL={{rpcUrl}}
CHAIN_ID={{chainId}}

# LLM
LLM_PROVIDER={{llm}}
LLM_MODEL={{model}}
{{#if isVenice}}
VENICE_API_KEY={{llmApiKey}}
VENICE_BASE_URL=https://api.venice.ai/api/v1
{{else}}
LLM_API_KEY={{llmApiKey}}
{{/if}}

{{#if hasUniswap}}
# Uniswap Trading API (get key at https://hub.uniswap.org)
UNISWAP_API_KEY=

{{/if}}
{{#if hasNansenMcp}}
# Nansen MCP (blockchain analytics via MCP server)
NANSEN_API_KEY=

{{/if}}
{{#if hasAgentcashMcp}}
# AgentCash MCP (optional bootstrap invite code)
AGENTCASH_INVITE_CODE=
# Optional: override AgentCash wallet private key or enable debug logs
# X402_PRIVATE_KEY=
# X402_DEBUG=true

{{/if}}
{{#if hasNansenX402}}
# Nansen x402 (override default endpoint if needed)
# NANSEN_X402_URL=https://api.nansen.ai/x402

{{/if}}
{{#if hasVirtuals}}
# Virtuals ACP CLI
# Install the ACP CLI so the `acp` command is available, or point this at the executable path.
VIRTUALS_ACP_BIN=acp

{{/if}}
# Agent Loop
TEST_MODE={{testMode}}
AGENT_INTERVAL_SECONDS={{defaultAgentIntervalSeconds}}
{{#if isSelfUpdating}}

# Self-Updating Strategy
SELF_UPDATING=true
EVALUATION_INTERVAL_MINUTES={{evaluationInterval}}
# By default, model-proposed strategy changes are written to prompts/strategy.proposed.md
# for human review and are NOT used as the system prompt. Set to true to apply them
# automatically (the model can then rewrite its own instructions without review).
AUTO_APPLY_STRATEGY_UPDATES=false
{{/if}}

# Guardrails (enforced in code by src/guardrails.ts; loosen at your own risk)
# Max slippage tolerance. Swap/perp tool slippage inputs above this are clamped to it.
SLIPPAGE_PCT={{defaultSlippagePct}}
# Stop-loss threshold. Prompt guidance only; not enforced per tool call.
STOP_LOSS_PCT={{defaultStopLossPct}}
# Max % of wallet value per trade. Enforced only when the wallet adapter reports a USD
# total (Bankr, Sponge) and the tool input is USD/stablecoin-denominated.
MAX_POSITION_PCT={{defaultMaxPositionPct}}
# Absolute per-trade cap in USD for USD/stablecoin-denominated tool inputs
# (stablecoin swap inputs, Avantis collateral, Sponge Hyperliquid/Polymarket sizes, etc.).
# Defaults to 100 when unset. Set to "unlimited" to disable.
MAX_TRADE_USD=100
# Comma-separated, case-insensitive allowlist of destination addresses (or ENS names)
# for arbitrary-destination tools: raw transaction / contract write targets and the
# recipients/spenders/operators decoded from their calldata, transfers, and approvals to
# spenders other than the protocol routers the tools hardcode.
# Empty = all arbitrary-destination calls are blocked.
ALLOWED_ADDRESSES=
{{#if isCdpServerWallet}}
# Raw calls (cdp_send_transaction / cdp_contract_write) may only carry decoded ERC-20/721/1155
# transfer and approval calldata whose effect passes the policies above. Setting this to true
# also allows calldata the guardrails cannot decode, which grants the agent UNRESTRICTED
# execution authority on every allowlisted target contract. Default false.
ALLOW_ARBITRARY_CALLDATA=false
{{/if}}
{{#if isBankr}}
# bankr_execute takes free-text prompts that guardrails cannot reliably inspect, so it is
# blocked by default. Setting this to true enables it: effectively UNRESTRICTED, only
# best-effort prompt checks (allowlisted addresses, MAX_TRADE_USD amounts) apply.
BANKR_ALLOW_EXECUTE=false
{{/if}}
{{#if hasAnyX402}}
# Per-payment cap (USD, paid in USDC on Base) for x402 paid-data requests made through
# src/tools/x402/client.ts. Payments above this are refused. Default 0.10.
MAX_X402_PAYMENT_USD=0.10
{{/if}}
{{#if (or isSponge hasAnyX402)}}
# Comma-separated extra hostnames x402 requests may pay{{#if isSponge}} (sponge_x402_fetch pays only these){{/if}}.
{{#if hasAnyX402}}
# The built-in x402 data tools' fixed hosts are always allowed.
{{/if}}
# Empty = no extra hosts.
ALLOWED_X402_HOSTS=
{{/if}}
# Default-deny: tools that are not built-in read-only tools and have no guardrail policy
# (MCP tools{{#if hasAgentcashMcp}} such as AgentCash's{{/if}}, custom tools) are blocked. List tool names here
# (comma-separated) to let them run WITHOUT any guardrail checks.
GUARDRAIL_ALLOW_TOOLS=

# LangSmith (optional tracing — uncomment to enable)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT={{name}}
